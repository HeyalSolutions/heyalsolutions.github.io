---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallToAction from "../components/CallToAction.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Show the closing "get in touch" band above the footer. */
  cta?: boolean;
}

const { title: pageTitle, description = site.description, cta = true } = Astro.props;
const title = pageTitle ? `${pageTitle} | ${site.name}` : `${site.name} | Cloud native platform consultancy`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB" class="bg-ink-50 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&display=swap"
    />
  </head>
  <body class="text-ink-900 selection:bg-accent-300">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    {cta && <CallToAction />}
    <Footer />
  </body>
</html>
