---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallToAction from "../components/CallToAction.astro";
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { site } from "../data/site";
import { graph, organization, website } from "../lib/seo";
import defaultShareImage from "../assets/og-default.jpg";

interface Props {
  title?: string;
  description?: string;
  /** Show the closing "get in touch" band above the footer. */
  cta?: boolean;
  ogType?: "website" | "article";
  /** Social share image, cropped to 1200x630. Falls back to the site-wide image. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Article timestamps, rendered as article:* Open Graph tags. */
  published?: Date;
  modified?: Date;
  /** Keep this page out of search results. */
  noindex?: boolean;
  /** schema.org nodes for this page. The organization and website are always included. */
  schema?: object[];
}

const {
  title: pageTitle,
  description = site.description,
  cta = true,
  ogType = "website",
  image = defaultShareImage,
  imageAlt = site.name,
  published,
  modified,
  noindex = false,
  schema = [],
} = Astro.props;
const title = pageTitle ? `${pageTitle} | ${site.name}` : site.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg" });
const shareImageUrl = new URL(shareImage.src, Astro.site);
---

<!doctype html>
<html lang="en-GB" class="bg-ink-50 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Set the theme before first paint to avoid a flash. A saved choice wins; otherwise follow the OS.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {ogType === "article" && <meta property="article:author" content={new URL("/about/", Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph(organization, website, ...schema))} />
    <Font cssVariable="--font-manrope" preload />
  </head>
  <body class="text-ink-900 selection:bg-accent-300 dark:selection:bg-accent-500/40">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    {cta && <CallToAction />}
    <Footer />
  </body>
</html>
