---
import type { CollectionEntry } from "astro:content";

interface Props {
  study: CollectionEntry<"work">;
}

const { study } = Astro.props;
---

<a href={`/work/${study.id}/`} class="group flex flex-col border-t-[3px] border-ink-900 pt-6 pb-4">
  <p class="flex items-center gap-x-3 text-base text-ink-500">
    <span>{study.data.sector}</span>
    {study.data.draft && <span class="rounded-full bg-accent-300 px-2 text-xs font-semibold text-brand-950">Draft</span>}
  </p>
  <h3 class="mt-2 text-3xl font-bold tracking-[-0.03em] text-ink-900 decoration-accent-400 decoration-[3px] underline-offset-[6px] group-hover:underline">
    {study.data.client}
  </h3>
  <p class="mt-3 flex-auto text-lg/8 text-ink-700">{study.data.summary}</p>
  <p class="mt-4 text-base font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">Read the case study</p>
</a>
