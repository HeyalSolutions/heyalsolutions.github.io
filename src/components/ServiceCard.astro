---
import type { CollectionEntry } from "astro:content";

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
---

<a href={`/services/${service.id}/`} class="group flex flex-col border-t-[3px] border-ink-900 pt-6 pb-4">
  <h3 class="text-3xl font-bold tracking-[-0.03em] text-ink-900 decoration-accent-400 decoration-[3px] underline-offset-[6px] group-hover:underline">
    {service.data.title}
  </h3>
  <p class="mt-3 max-w-lg flex-auto text-lg/8 text-ink-700">{service.data.summary}</p>
  <p class="mt-4 text-base font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">Learn more</p>
</a>
