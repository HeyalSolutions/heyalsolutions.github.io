---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="relative isolate overflow-hidden border-b border-ink-200">
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--color-ink-200)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-ink-200)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_80%_at_20%_0%,#000_30%,transparent_100%)]"
    aria-hidden="true"
  >
  </div>
  <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28 lg:px-8">
    <p class="text-base/7 font-semibold text-brand-600 dark:text-brand-400">{eyebrow}</p>
    <h1 class="mt-2 max-w-3xl text-4xl font-semibold tracking-tight text-pretty text-ink-900 sm:text-6xl">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg/8 text-pretty text-ink-600">{lead}</p>}
    <slot />
  </div>
</div>
