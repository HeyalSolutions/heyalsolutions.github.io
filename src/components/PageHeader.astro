---
import Flatline from "./Flatline.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<div class="border-b-[3px] border-ink-900">
  <div class="mx-auto max-w-7xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-20 lg:px-8">
    <p class="flex items-center gap-4 text-base/7 font-medium text-ink-500">
      <Flatline variant="rule" class="w-16 text-ink-900" />
      {eyebrow}
    </p>
    <h1 class="mt-6 max-w-4xl text-5xl font-extrabold tracking-[-0.045em] text-balance text-ink-900 sm:text-7xl/[0.95]">
      {title}
    </h1>
    {lead && <p class="mt-8 max-w-2xl text-xl/8 text-pretty text-ink-700">{lead}</p>}
    <slot />
  </div>
</div>
