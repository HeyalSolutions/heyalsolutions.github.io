---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "inline-flex size-9 items-center justify-center rounded-full text-ink-700 ring-1 ring-ink-900/10 hover:bg-ink-100 hover:text-ink-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700",
    className,
  ]}
>
  <span class="sr-only">Toggle dark mode</span>
  <!-- Moon (shown in light mode) -->
  <svg class="size-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
    ></path>
  </svg>
  <!-- Sun (shown in dark mode) -->
  <svg class="hidden size-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
    ></path>
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function apply(theme: Theme): void {
    root.dataset.theme = theme;
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(theme === "dark")));
  }

  function savedTheme(): Theme | null {
    try {
      const value = localStorage.getItem("theme");
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  }

  apply(root.dataset.theme === "dark" ? "dark" : "light");

  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const next: Theme = root.dataset.theme === "dark" ? "light" : "dark";
      apply(next);
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage unavailable (e.g. private mode): the choice lasts for this page only.
      }
    }),
  );

  // Follow OS changes until the visitor makes an explicit choice.
  media.addEventListener("change", (e) => {
    if (!savedTheme()) apply(e.matches ? "dark" : "light");
  });
</script>
