---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { author } from "../data/site";

interface Props {
  /** Rendered size in pixels. */
  size?: number;
  class?: string;
}

const { size = 40, class: className = "" } = Astro.props;

// The photo is optional: drop a square image at src/assets/author.jpg (or .png, .webp) and it is used everywhere.
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/author.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(photos)[0]?.default;
---

{
  photo ? (
    <Image
      src={photo}
      alt={author.name}
      width={size}
      height={size}
      densities={[1, 2]}
      class:list={["flex-none rounded-full object-cover ring-1 ring-ink-200", className]}
    />
  ) : (
    <span
      class:list={[
        "inline-flex flex-none items-center justify-center rounded-full bg-brand-950 font-semibold text-accent-400 ring-1 ring-ink-200",
        className,
      ]}
      style={`width: ${size}px; height: ${size}px; font-size: ${Math.round(size * 0.38)}px`}
      aria-hidden="true"
    >
      {author.initials}
    </span>
  )
}
