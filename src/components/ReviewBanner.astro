---
import Icon from "./Icon.astro";
import { review } from "../data/site";
---

<a
  href={review.href}
  class="group flex flex-col gap-6 rounded-2xl bg-surface p-8 ring-2 ring-accent-400 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand-900/5 sm:flex-row sm:items-center"
>
  <span class="flex size-11 flex-none items-center justify-center rounded-full bg-accent-300/30 text-accent-500 ring-1 ring-accent-400/50">
    <Icon name="search" class="size-6" />
  </span>
  <div class="flex-auto">
    <p class="text-sm/6 font-semibold text-accent-500">Not sure where to start?</p>
    <h3 class="mt-1 text-lg/7 font-semibold text-ink-900">{review.name}</h3>
    <p class="mt-2 max-w-2xl text-base/7 text-ink-600">{review.pitch}</p>
  </div>
  <p class="flex-none text-sm/6 font-semibold text-brand-700 dark:text-brand-300">
    How it works <span aria-hidden="true" class="inline-block transition group-hover:translate-x-0.5">→</span>
  </p>
</a>
