---
import { review } from "../data/site";
---

<a
  href={review.href}
  class="group flex flex-col gap-6 rounded-[2rem] bg-accent-400 p-8 text-brand-950 sm:flex-row sm:items-center sm:p-10"
>
  <div class="flex-auto">
    <p class="text-base/7 font-semibold">Not sure where to start?</p>
    <h3 class="mt-1 text-3xl font-extrabold tracking-[-0.035em] sm:text-4xl">{review.name}</h3>
    <p class="mt-3 max-w-2xl text-lg/8">{review.pitch}</p>
  </div>
  <p class="flex-none rounded-full bg-brand-950 px-6 py-3.5 text-base font-bold text-ink-50 group-hover:bg-brand-800 dark:text-[#e8eee3]">
    How it works
  </p>
</a>
