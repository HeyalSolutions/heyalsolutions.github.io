---
import type { CollectionEntry } from "astro:content";

interface Props {
  current: CollectionEntry<"blog">;
  parts: CollectionEntry<"blog">[];
}

const { current, parts } = Astro.props;
const series = current.data.series!;
// Titles repeat the series name ("My Home Office Build, Part 2: Frame…"); show just the part's own name.
const shortTitle = (title: string) => title.replace(/^.*?Part \d+:\s*/, "");
---

<nav aria-label={`${series.title} series`} class="rounded-2xl bg-surface p-6 ring-1 ring-ink-200">
  <p class="text-sm/6 font-semibold text-ink-900">
    {series.title} <span class="font-normal text-ink-500">· Part {series.part} of {parts.length}</span>
  </p>
  <ol role="list" class="mt-3 space-y-1">
    {
      parts.map((part) => {
        const isCurrent = part.id === current.id;
        return (
          <li class="flex gap-x-3 text-sm/6">
            <span class="w-4 flex-none font-mono text-accent-500">{part.data.series!.part}</span>
            {isCurrent ? (
              <span aria-current="page" class="font-semibold text-ink-900">
                {shortTitle(part.data.title)}
              </span>
            ) : (
              <a href={`/blog/${part.id}/`} class="text-brand-700 hover:text-brand-600 dark:text-brand-300 dark:hover:text-brand-200">
                {shortTitle(part.data.title)}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
