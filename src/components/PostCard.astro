---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate, readingTime } from "../lib/content";
import { author } from "../data/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<article class="group relative flex flex-col">
  <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-ink-100">
    {
      post.data.heroImage ? (
        <Image
          src={post.data.heroImage}
          alt=""
          widths={[400, 800]}
          sizes="(min-width: 1024px) 400px, 100vw"
          class="size-full object-cover transition duration-300 group-hover:scale-[1.02]"
        />
      ) : (
        <div class="flex size-full flex-col justify-between bg-brand-900 p-6 text-[#e8eee3]">
          <p class="font-display text-xl/6 font-bold tracking-[-0.03em] text-balance">{post.data.title}</p>
          <svg viewBox="0 0 200 24" class="h-5 w-full" fill="none" aria-hidden="true">
            <path d="M0 16 L10 6 L18 20 L26 4 L34 18 L42 14 L50 17 L194 17" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <circle cx="194" cy="17" r="4" fill="var(--color-accent-400)" />
          </svg>
        </div>
      )
    }
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-x-3 text-sm/6 text-ink-500">
    <span class="font-medium text-ink-700">{author.name}</span>
    <span aria-hidden="true">·</span>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime(post.body)} min read</span>
  </div>
  <h3 class="mt-2 text-xl/7 font-bold tracking-[-0.025em] text-ink-900 decoration-accent-400 decoration-2 underline-offset-4 group-hover:underline">
    <a href={`/blog/${post.id}/`}>
      <span class="absolute inset-0"></span>
      {post.data.title}
    </a>
  </h3>
  <p class="mt-2 text-base/7 text-ink-600">{post.data.description}</p>
</article>
