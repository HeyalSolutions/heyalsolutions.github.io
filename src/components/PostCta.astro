---
import { postCtas, site, type PostCtaId } from "../data/site";

interface Props {
  id: PostCtaId;
}

const cta = postCtas[Astro.props.id];
---

<aside class="mx-auto max-w-3xl px-6 pb-16 lg:px-8" aria-label="Work with us">
  <div class="rounded-[2rem] bg-brand-900 p-8 sm:p-10 dark:bg-ink-100">
    <h2 class="text-3xl font-extrabold tracking-[-0.035em] text-pretty text-[#e8eee3]">{cta.heading}</h2>
    <p class="mt-3 text-base/7 text-[#e8eee3]/80">{cta.body}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href={cta.href}
        class="rounded-full bg-accent-400 px-6 py-3 text-base font-bold text-brand-950 hover:bg-accent-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-400"
      >
        {cta.label}
      </a>
      <a href={`mailto:${site.email}`} class="text-base font-semibold text-[#e8eee3] underline decoration-accent-400 decoration-2 underline-offset-4">
        {site.email}
      </a>
    </div>
  </div>
</aside>
