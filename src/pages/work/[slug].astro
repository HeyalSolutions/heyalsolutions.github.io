---
import type { GetStaticPaths } from "astro";
import { getEntries, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCaseStudies } from "../../lib/content";
import { breadcrumbs } from "../../lib/seo";

export const getStaticPaths = (async () => {
  const studies = await getCaseStudies();
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}) satisfies GetStaticPaths;

const { study } = Astro.props;
const { Content } = await render(study);
const services = await getEntries(study.data.services);
const schema = [
  breadcrumbs([
    { name: "Work", path: "/work/" },
    { name: study.data.title, path: `/work/${study.id}/` },
  ]),
];

const details = [
  { label: "Client", value: study.data.client },
  { label: "Duration", value: study.data.duration },
  { label: "Team", value: study.data.team },
].filter((d): d is { label: string; value: string } => Boolean(d.value));
---

<Base title={study.data.title} description={study.data.summary} schema={schema}>
  <PageHeader eyebrow={`Case study · ${study.data.sector}`} title={study.data.title} lead={study.data.summary}>
    {
      study.data.stack.length > 0 && (
        <ul role="list" class="mt-8 flex flex-wrap gap-2">
          {study.data.stack.map((tool) => (
            <li class="rounded-full bg-surface px-3 py-1 text-sm/6 text-ink-700 ring-1 ring-ink-200">{tool}</li>
          ))}
        </ul>
      )
    }
  </PageHeader>

  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-12 lg:px-8">
      <aside class="space-y-8 lg:order-last lg:col-span-4">
        <div class="rounded-2xl bg-brand-950 p-8 text-white">
          <h2 class="text-sm/6 font-semibold text-accent-400">Results</h2>
          <ul role="list" class="mt-4 space-y-4">
            {study.data.results.map((r) => <li class="text-base/7 font-medium">{r}</li>)}
          </ul>
        </div>
        <dl class="space-y-6 rounded-2xl bg-surface p-8 ring-1 ring-ink-200 text-sm/6">
          {
            details.map((d) => (
              <div>
                <dt class="font-semibold text-ink-900">{d.label}</dt>
                <dd class="mt-1 text-ink-600">{d.value}</dd>
              </div>
            ))
          }
          <div>
            <dt class="font-semibold text-ink-900">Services</dt>
            <dd class="mt-1">
              <ul role="list" class="space-y-1">
                {
                  services.map((s) => (
                    <li>
                      <a href={`/services/${s.id}/`} class="font-medium text-brand-700 dark:text-brand-300 hover:text-brand-600 dark:hover:text-brand-200">
                        {s.data.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </aside>
      <div
        class="prose prose-lg max-w-none lg:col-span-8 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-brand-700"
      >
        <Content />
      </div>
    </div>
  </section>
</Base>
