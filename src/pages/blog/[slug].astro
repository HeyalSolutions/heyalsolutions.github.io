---
import type { GetStaticPaths } from "astro";
import { getEntry, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import PostCta from "../../components/PostCta.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
import { formatDate, getPosts, readingTime, relatedPosts } from "../../lib/content";
import { breadcrumbs, founder, ids } from "../../lib/seo";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => {
    const seriesId = post.data.series?.id;
    const parts = seriesId
      ? posts.filter((p) => p.data.series?.id === seriesId).sort((a, b) => a.data.series!.part - b.data.series!.part)
      : [];
    return { params: { slug: post.id }, props: { post, parts, related: relatedPosts(post, posts) } };
  });
}) satisfies GetStaticPaths;

const { post, parts, related } = Astro.props;
const index = parts.findIndex((p) => p.id === post.id);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, heroAlt, personal, changes, tags, cta } = post.data;
const service = post.data.service ? await getEntry(post.data.service) : undefined;

const path = `/blog/${post.id}/`;
const shareImage = heroImage ? new URL((await getImage({ src: heroImage, width: 1200, height: 630, fit: "cover", format: "jpg" })).src, Astro.site) : undefined;
const schema = [
  {
    "@type": "BlogPosting",
    "@id": new URL(`${path}#article`, Astro.site).toString(),
    mainEntityOfPage: new URL(path, Astro.site).toString(),
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: founder,
    publisher: { "@id": ids.organization },
    inLanguage: "en-GB",
    wordCount: (post.body ?? "").split(/\s+/).filter(Boolean).length,
    ...(shareImage && { image: shareImage.toString() }),
    ...(tags.length > 0 && { keywords: tags.join(", ") }),
    ...(post.data.series && {
      isPartOf: { "@type": "CreativeWorkSeries", name: post.data.series.title },
      position: post.data.series.part,
    }),
  },
  breadcrumbs([
    { name: "Blog", path: "/blog/" },
    { name: title, path },
  ]),
];

// Technical posts older than two years get a notice that tools and versions have moved on.
const TWO_YEARS_MS = 2 * 365 * 24 * 60 * 60 * 1000;
const isOld = Date.now() - (updatedDate ?? pubDate).valueOf() > TWO_YEARS_MS;
const showNotice = !personal && (isOld || Boolean(changes));
const writtenIn = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric" }).format(pubDate);
---

<Base
  title={title}
  description={description}
  ogType="article"
  image={heroImage}
  imageAlt={heroAlt || title}
  published={pubDate}
  modified={updatedDate}
  schema={schema}
  cta={!cta}
>
  <article>
    <header class="mx-auto max-w-3xl px-6 pt-16 sm:pt-24 lg:px-8">
      <a href="/blog/" class="text-sm/6 font-semibold text-brand-700 dark:text-brand-300"
        ><span aria-hidden="true">←</span> All posts</a
      >
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-pretty text-ink-900 sm:text-5xl">{title}</h1>
      <p class="mt-6 text-lg/8 text-ink-600">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 text-sm/6 text-ink-500">
        <span class="font-medium text-ink-900">{site.founder}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </div>
    </header>

    {
      heroImage && (
        <div class="mx-auto mt-12 max-w-5xl px-6 lg:px-8">
          <Image
            src={heroImage}
            alt={heroAlt}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1024px) 1024px, 100vw"
            loading="eager"
            class="aspect-[2/1] w-full rounded-2xl object-cover ring-1 ring-ink-200"
          />
        </div>
      )
    }

    {
      parts.length > 1 && (
        <div class="mx-auto mt-12 max-w-3xl px-6 lg:px-8">
          <SeriesNav current={post} parts={parts} />
        </div>
      )
    }

    {
      showNotice && (
        <aside
          class="mx-auto mt-12 max-w-3xl px-6 lg:px-8"
          aria-label="Note about this post's age"
        >
          <div class="flex gap-x-4 rounded-2xl border-l-4 border-accent-400 bg-ink-100 p-6">
            <svg class="mt-0.5 size-5 flex-none text-accent-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
                clip-rule="evenodd"
              />
            </svg>
            <div class="text-base/7 text-ink-700">
              <p>
                <strong class="font-semibold text-ink-900">This post was written in {writtenIn}.</strong> The tools it
                covers have moved on since, so versions, commands, flags and screenshots may no longer match current
                releases. Check each project's documentation for the latest details.
              </p>
              {changes && <p class="mt-3">{changes}</p>}
            </div>
          </div>
        </aside>
      )
    }

    <div
      class="prose prose-lg mx-auto max-w-3xl px-6 py-16 lg:px-8 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-brand-700 dark:prose-a:text-brand-300 prose-img:rounded-xl prose-pre:rounded-xl prose-pre:ring-1 prose-pre:ring-ink-200"
    >
      <Content />
    </div>

    {
      (previous || next) && (
        <nav aria-label="Series navigation" class="mx-auto max-w-3xl px-6 pb-16 lg:px-8">
          <div class="grid grid-cols-1 gap-4 border-t border-ink-200 pt-8 sm:grid-cols-2">
            {previous && (
              <a href={`/blog/${previous.id}/`} class="group rounded-xl p-4 ring-1 ring-ink-200 hover:ring-brand-300 dark:hover:ring-brand-700">
                <span class="text-sm/6 text-ink-500">← Part {previous.data.series!.part}</span>
                <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700 dark:group-hover:text-brand-300">
                  {previous.data.title}
                </span>
              </a>
            )}
            {next && (
              <a
                href={`/blog/${next.id}/`}
                class="group rounded-xl p-4 text-right ring-1 ring-ink-200 hover:ring-brand-300 sm:col-start-2 dark:hover:ring-brand-700"
              >
                <span class="text-sm/6 text-ink-500">Part {next.data.series!.part} →</span>
                <span class="mt-1 block font-semibold text-ink-900 group-hover:text-brand-700 dark:group-hover:text-brand-300">
                  {next.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }

    {/* A post-specific call to action wins over the generic related-service box. */}
    {cta && <PostCta id={cta} />}
    {
      !cta && service && (
        <aside aria-label="Related service" class="mx-auto max-w-3xl px-6 pb-16 lg:px-8">
          <a
            href={`/services/${service.id}/`}
            class="group block rounded-2xl bg-brand-950 p-8 text-white ring-1 ring-brand-900 hover:ring-brand-500"
          >
            <span class="text-sm/6 font-semibold text-accent-400">Need a hand with this?</span>
            <span class="mt-2 block text-xl font-semibold tracking-tight">{service.data.title}</span>
            <span class="mt-2 block text-base/7 text-brand-100/70">{service.data.summary}</span>
            <span class="mt-4 inline-block text-sm/6 font-semibold">
              How we help <span aria-hidden="true">→</span>
            </span>
          </a>
        </aside>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related-heading" class="border-t border-ink-200 py-20 sm:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <h2 id="related-heading" class="text-2xl font-semibold tracking-tight text-ink-900">
            Related posts
          </h2>
          <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
