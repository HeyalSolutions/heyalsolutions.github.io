---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/content";

const posts = await getPosts();

const categories = [
  { id: "all", label: "Everything" },
  { id: "engineering", label: "Engineering" },
  { id: "leadership", label: "Engineering leaders" },
  { id: "business", label: "Business" },
] as const;
---

<Base title="Blog" description="Practical writing on Kubernetes, EKS, GitOps, Terraform and platform engineering from the Heyal Solutions team, based on real client work.">
  <PageHeader
    eyebrow="Blog"
    title="Notes from the platform"
    lead="Hands-on writing on Kubernetes, GitOps and platform engineering, the business case behind it for the people who decide, and plain-English notes on the apps we build for businesses that aren't software companies."
  >
    <a href="/blog/rss.xml" class="mt-8 inline-flex items-center gap-x-2 text-sm/6 font-semibold text-brand-700 dark:text-brand-300">
      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M3.75 3a.75.75 0 0 0-.75.75v.5c0 .414.336.75.75.75H4c6.075 0 11 4.925 11 11v.25c0 .414.336.75.75.75h.5a.75.75 0 0 0 .75-.75V16C17 8.82 11.18 3 4 3h-.25Z"></path>
        <path d="M3 8.75A.75.75 0 0 1 3.75 8H4a8 8 0 0 1 8 8v.25a.75.75 0 0 1-.75.75h-.5a.75.75 0 0 1-.75-.75V16a6 6 0 0 0-6-6h-.25A.75.75 0 0 1 3 9.25v-.5ZM7 15a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"></path>
      </svg>
      RSS feed
    </a>
  </PageHeader>
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-12 flex flex-wrap gap-2" role="group" aria-label="Filter posts">
        {
          categories.map((category) => (
            <button
              type="button"
              data-filter={category.id}
              aria-pressed={category.id === "all"}
              class="rounded-full px-4 py-1.5 text-sm/6 font-semibold text-ink-600 ring-1 ring-ink-200 transition hover:text-ink-900 aria-pressed:bg-brand-700 aria-pressed:text-white aria-pressed:ring-brand-700 dark:aria-pressed:bg-brand-300 dark:aria-pressed:text-brand-950"
            >
              {category.label}
            </button>
          ))
        }
      </div>
      <div class="grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <div data-category={post.data.category}>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("[data-category]");
    const apply = (filter: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
      cards.forEach((c) => c.toggleAttribute("hidden", filter !== "all" && c.dataset.category !== filter));
      history.replaceState(null, "", filter === "all" ? location.pathname : `#${filter}`);
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.filter!)));
    const initial = location.hash.slice(1);
    if ([...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
  </script>
</Base>
