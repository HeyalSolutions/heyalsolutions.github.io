---
import Base from "../layouts/Base.astro";
import Flatline from "../components/Flatline.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ReviewBanner from "../components/ReviewBanner.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import PostCard from "../components/PostCard.astro";
import { principles, problems, review, site } from "../data/site";
import { getCaseStudies, getPosts, getServices } from "../lib/content";
import { founder } from "../lib/seo";

const services = await getServices();
const caseStudies = (await getCaseStudies()).slice(0, 2);
const posts = (await getPosts()).filter((post) => !post.data.personal).slice(0, 3);
---

<Base schema={[founder]}>
  <!-- Hero -->
  <section class="overflow-hidden">
    <div class="mx-auto max-w-7xl px-6 pt-14 sm:pt-20 lg:px-8">
      <h1 class="text-[clamp(4rem,15vw,11.5rem)]/[0.86] font-extrabold tracking-[-0.055em] text-ink-900">
        Nothing<br />happened.
      </h1>
      <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:items-end">
        <p class="max-w-xl text-xl/8 text-pretty text-ink-800 sm:text-2xl/9">
          That's the job. We make shipping software boring by designing, building and fixing the platforms your
          engineers ship on.
        </p>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 lg:justify-end">
          <a
            href={review.href}
            class="rounded-full bg-accent-400 px-7 py-4 text-lg font-bold text-brand-950 hover:bg-accent-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink-900"
          >
            Book a platform review
          </a>
          <a href="/services/" class="text-lg font-semibold text-ink-900 underline decoration-2 underline-offset-[6px]">
            See what we do
          </a>
        </div>
      </div>
    </div>
    <Flatline class="mt-12 sm:mt-16" />
  </section>

  <!-- Problems -->
  <section class="bg-brand-900 py-20 text-[#e8eee3] sm:py-28 dark:bg-ink-100">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[22rem_1fr] lg:gap-16 lg:px-8">
      <div>
        <h2 class="text-5xl/[0.95] font-extrabold tracking-[-0.045em] sm:text-6xl/[0.95]">Things that will stop happening</h2>
        <p class="mt-6 text-lg/8 opacity-80">
          These are fixable problems, and none of them needs a big-bang rewrite.
        </p>
      </div>
      <ul role="list">
        {
          problems.map((p) => (
            <li class="border-b border-[#e8eee3]/20 py-6 first:pt-0">
              <p class="font-display text-2xl font-bold tracking-[-0.025em] line-through decoration-accent-400 decoration-[3px] sm:text-3xl">
                {p.title}
              </p>
              <p class="mt-2 max-w-2xl text-lg/7 opacity-80">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="max-w-3xl text-5xl/[0.92] font-extrabold tracking-[-0.045em] text-ink-900 sm:text-7xl/[0.92]">
          Four ways to make it boring
        </h2>
        <a href="/services/" class="text-lg font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">All services</a>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-x-12 gap-y-8 sm:grid-cols-2">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="mt-12">
        <ReviewBanner />
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="border-t-[3px] border-ink-900 py-20 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[22rem_1fr] lg:gap-16 lg:px-8">
      <div>
        <h2 class="text-5xl/[0.95] font-extrabold tracking-[-0.045em] text-ink-900 sm:text-6xl/[0.95]">Small on purpose</h2>
        <p class="mt-6 text-lg/8 text-ink-700">
          {site.name} is led by {site.founder}, a cloud native platform engineer, and works with a small network of trusted
          senior associates. You get experienced people without the overhead of a big consultancy.
        </p>
        <a href="/how-we-work/" class="mt-6 inline-block text-lg font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">
          How engagements work
        </a>
      </div>
      <dl class="grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-3">
        {
          principles.map((item) => (
            <div>
              <Flatline variant="rule" class="w-20 text-ink-900" />
              <dt class="mt-5 font-display text-2xl/7 font-bold tracking-[-0.025em] text-ink-900">{item.title}</dt>
              <dd class="mt-3 text-base/7 text-ink-700">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Case studies (only rendered once at least one is published) -->
  {
    caseStudies.length > 0 && (
      <section class="border-t-[3px] border-ink-900 py-20 sm:py-28">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="text-5xl/[0.95] font-extrabold tracking-[-0.045em] text-ink-900 sm:text-6xl/[0.95]">Recent work</h2>
            <a href="/work/" class="text-lg font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">
              All case studies
            </a>
          </div>
          <div class="mt-14 grid grid-cols-1 gap-x-12 gap-y-8 lg:grid-cols-2">
            {caseStudies.map((study) => (
              <CaseStudyCard study={study} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Writing -->
  <section class="border-t-[3px] border-ink-900 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-5xl/[0.95] font-extrabold tracking-[-0.045em] text-ink-900 sm:text-6xl/[0.95]">We write about what we build</h2>
        <a href={site.blog} class="text-lg font-semibold text-ink-900 underline decoration-accent-400 decoration-2 underline-offset-4">Read the blog</a>
      </div>
      <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-16 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</Base>
