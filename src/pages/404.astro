---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" cta={false} noindex>
  <section class="mx-auto max-w-7xl px-6 py-32 text-center sm:py-48 lg:px-8">
    <p class="font-mono text-base font-semibold text-accent-500">404</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-tight text-ink-900 sm:text-6xl">Page not found</h1>
    <p class="mt-6 text-lg/8 text-ink-600">That page doesn't exist, or it's moved.</p>
    <a href="/" class="mt-10 inline-block rounded-full bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-600"
      >Back to home</a
    >
  </section>
</Base>
