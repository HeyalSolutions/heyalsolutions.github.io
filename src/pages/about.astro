---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const focus = [
  "Kubernetes and cloud native architecture",
  "Infrastructure as code",
  "GitOps and continuous delivery",
  "Public cloud on AWS, Google Cloud and Azure",
  "Serverless and event-driven platforms",
  "Building a healthy DevOps culture",
];
---

<Base title="About" description={`${site.name} is a founder-led cloud native consultancy in Birmingham, UK, helping engineering teams build and run Kubernetes platforms, infrastructure as code and delivery pipelines.`}>
  <PageHeader
    eyebrow="About"
    title="Engineers first, consultants second"
    lead={`${site.name} is a founder-led cloud native consultancy based in the UK. We exist to help engineering teams spend less time fighting their platform and more time building for their customers.`}
  />

  <section class="py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-16 px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <h2 class="text-3xl font-semibold tracking-tight text-ink-900">{site.founder}, founder</h2>
        <div class="mt-6 space-y-6 text-lg/8 text-ink-600">
          <p>
            Alistair is a cloud native platform engineer and programmer. He started {site.name} to do the kind of work he
            enjoys most: building platforms that developers actually like using, and helping teams build the skills and
            habits to keep them that way.
          </p>
          <p>
            He oversees every engagement and sets the standard for how we work. Projects are delivered by Alistair and a
            small network of senior associates, people he's worked with and would vouch for.
          </p>
          <p>
            He writes about Kubernetes, GitOps, Helm and serverless on the <a
              href={site.blog}
              class="font-semibold text-brand-700 dark:text-brand-300 hover:text-brand-600 dark:hover:text-brand-200">Heyal blog</a
            >.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm/6 font-semibold">
          <a href={site.linkedin} class="text-brand-700 dark:text-brand-300 hover:text-brand-600 dark:hover:text-brand-200">LinkedIn <span aria-hidden="true">→</span></a>
          <a href={site.github} class="text-brand-700 dark:text-brand-300 hover:text-brand-600 dark:hover:text-brand-200">GitHub <span aria-hidden="true">→</span></a>
          <a href={site.blog} class="text-brand-700 dark:text-brand-300 hover:text-brand-600 dark:hover:text-brand-200">Blog <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-2xl bg-surface p-8 ring-1 ring-ink-200">
          <h2 class="text-base/7 font-semibold text-ink-900">Focus areas</h2>
          <ul role="list" class="mt-6 space-y-3">
            {focus.map((item) => <li class="border-l-2 border-accent-400 pl-4 text-base/7 text-ink-700">{item}</li>)}
          </ul>
        </div>
        <dl class="mt-8 space-y-4 rounded-2xl bg-ink-100 p-8 text-sm/6">
          <div>
            <dt class="font-semibold text-ink-900">Company</dt>
            <dd class="text-ink-600">{site.legalName}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Registered in</dt>
            <dd class="text-ink-600">England &amp; Wales, no. {site.companyNumber}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-900">Based in</dt>
            <dd class="text-ink-600">{site.registeredAddress}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Base>
